{#-
  application-test.yml.j2 — Profile 'test' for Testcontainers + Artemis embedded.

  Variables:
    - service_type: "standard" | "gateway" | "registry"
-#}
{% if service_type in ("gateway", "registry") -%}
# Profile 'test' — sem datasource/Artemis (serviço de infra, não persiste estado).
eureka:
  client:
    enabled: false
{% else -%}
{% if events_broker == "kafka" -%}
# Profile 'test' — Testcontainers (PostgreSQL + Kafka).
# DataSource and Kafka bootstrap-servers overridden via @DynamicPropertySource in BaseIntegrationTest.
spring:
  jpa:
    hibernate:
      ddl-auto: create-drop
  flyway:
    enabled: false
  kafka:
    bootstrap-servers: localhost:29092
{% else -%}
# Profile 'test' — Testcontainers (PostgreSQL) + Artemis embedded.
# DataSource sobrescrito via @DynamicPropertySource em BaseIntegrationTest.
spring:
  jpa:
    hibernate:
      ddl-auto: create-drop
  flyway:
    enabled: false
  artemis:
    mode: embedded
{% endif -%}

eureka:
  client:
    enabled: false
{%- endif %}
